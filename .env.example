NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_WEBHOOK_URL=https://your-domain.com/api/google/watch/webhook
WATCH_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Durable KV store for server-side state that must survive across serverless
# invocations (Google watch channels, Asana tokens, sync versions). Backed by
# Upstash Redis's REST API — provision a free store at https://upstash.com,
# or add the "Upstash for Redis" / "KV" integration from your Vercel project's
# Storage tab (which injects KV_REST_API_URL / KV_REST_API_TOKEN for you, no
# separate setup needed). Either var pair works; only one pair is required.
# If neither is set, lib/kv.ts falls back to a local JSON file under /tmp —
# fine for `npm run dev`, but NOT safe for production (state won't survive
# cold starts or be shared across instances).
UPSTASH_REDIS_REST_URL=replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Asana OAuth 2.0 integration
# Create an app at https://app.asana.com/0/my-apps
ASANA_CLIENT_ID=replace-with-asana-client-id
ASANA_CLIENT_SECRET=replace-with-asana-client-secret
# Must match the redirect URI registered in your Asana app
ASANA_REDIRECT_URI=http://localhost:3000/api/asana/callback
# Public URL that Asana can POST webhook events to (requires a public domain; use ngrok for local dev)
ASANA_WEBHOOK_URL=https://your-domain.com/api/asana/webhook
# Asana tokens and webhook secret persist to the shared KV store above (see
# UPSTASH_REDIS_REST_URL).
